{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "La Joya",
  "version": "../package.json",
  "identifier": "mx.jardineslajoya.reservaciones",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5180",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "principal",
        "title": "La Joya · Reservaciones",
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 640,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: https://*.supabase.co http://127.0.0.1:54331 http://localhost:54331",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co http://127.0.0.1:54331 ws://127.0.0.1:54331 http://localhost:54331 ws://localhost:54331",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Business",
    "copyright": "Jardines La Joya",
    "shortDescription": "Reservaciones del hospedaje de La Joya",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwNDQxREJDOUJDRjQxQjkKUldTNVFjK2J2QjFFY0h1NXZIRHBTRDc0YlRVMmxMdWNhZUFvaUpveG1iNHNxY3VCZVBDS1pzdzgK",
      "endpoints": []
    }
  }
}
