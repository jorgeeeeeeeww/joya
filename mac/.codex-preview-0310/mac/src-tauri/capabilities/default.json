{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Lo que la ventana principal puede pedirle a la Mac",
  "windows": ["principal"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-badge-count",
    "notification:default",
    "autostart:default",
    "opener:default",
    "process:default",
    "updater:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*.supabase.co" },
        { "url": "https://*.supabase.co/*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "http://127.0.0.1:*/*" },
        { "url": "http://localhost:*" },
        { "url": "http://localhost:*/*" }
      ]
    }
  ]
}
